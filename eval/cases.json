{
  "valid": [
    {
      "ask": "find files larger than 100MB",
      "expect": [
        "^find\\b",
        "-size\\s+\\+100M"
      ]
    },
    {
      "ask": "show which process is using port 8080",
      "expect": [
        "(lsof -i\\s*(tcp)?:8080|ss .*8080|netstat .*8080|fuser\\s+(-\\w+\\s+)*8080/tcp)"
      ]
    },
    {
      "ask": "count lines in all .js files",
      "expect": [
        "wc\\s+-l",
        "\\.js"
      ]
    },
    {
      "ask": "kill process named node",
      "expect": [
        "(pkill|killall)\\s+(-\\w+\\s+)?node"
      ]
    },
    {
      "ask": "show the last 50 lines of syslog and follow it",
      "expect": [
        "tail",
        "-[fn]|--follow",
        "50"
      ]
    },
    {
      "ask": "compress the folder logs into logs.tar.gz",
      "expect": [
        "tar",
        "logs\\.tar\\.gz"
      ]
    },
    {
      "ask": "extract archive.tar.gz",
      "expect": [
        "tar",
        "x",
        "archive\\.tar\\.gz"
      ]
    },
    {
      "ask": "search for the word TODO recursively in src",
      "expect": [
        "(grep|rg)",
        "TODO",
        "src"
      ]
    },
    {
      "ask": "show free memory in megabytes",
      "expect": [
        "free",
        "-m"
      ]
    },
    {
      "ask": "make script.sh executable",
      "expect": [
        "chmod",
        "\\+x|7\\d\\d",
        "script\\.sh"
      ]
    },
    {
      "ask": "show my public ip address",
      "expect": [
        "curl|wget|dig"
      ]
    },
    {
      "ask": "replace foo with bar in file.txt in place",
      "expect": [
        "sed",
        "-i",
        "s/foo/bar/",
        "file\\.txt"
      ]
    },
    {
      "ask": "list the 10 biggest directories here",
      "expect": [
        "du",
        "sort",
        "head|tail"
      ]
    },
    {
      "ask": "show git commits from the last week",
      "expect": [
        "git log",
        "since|after|week|7"
      ]
    },
    {
      "ask": "download https://example.com/a.zip",
      "expect": [
        "(curl|wget)",
        "example\\.com/a\\.zip"
      ]
    },
    {
      "ask": "show running docker containers",
      "expect": [
        "docker (ps|container ls)"
      ]
    },
    {
      "ask": "create a directory a/b/c including parents",
      "expect": [
        "mkdir\\s+-p",
        "a/b/c"
      ]
    },
    {
      "ask": "show environment variables containing PATH",
      "expect": [
        "(env|printenv|set)",
        "grep",
        "PATH"
      ]
    },
    {
      "ask": "count files in current directory",
      "expect": [
        "(ls|find)",
        "wc\\s+-l"
      ]
    },
    {
      "ask": "show cpu info",
      "expect": [
        "(lscpu|/proc/cpuinfo|nproc)"
      ]
    },
    {
      "ask": "pretty print data.json with jq and sort the keys",
      "expect": [
        "^jq\\b",
        "-S|--sort-keys",
        "data\\.json"
      ],
      "grounded": true
    },
    {
      "ask": "use jq to print only the raw name field of data.json",
      "expect": [
        "^jq\\b",
        "-r|--raw-output",
        "\\.name",
        "data\\.json"
      ],
      "grounded": true
    },
    {
      "ask": "convert video.mp4 to audio.mp3 using ffmpeg",
      "expect": [
        "^ffmpeg\\b",
        "-i\\s+video\\.mp4",
        "audio\\.mp3"
      ],
      "grounded": true
    },
    {
      "ask": "with lsof list open files of process 1234",
      "expect": [
        "^(sudo\\s+)?lsof\\b",
        "-p\\s*1234"
      ],
      "grounded": true
    },
    {
      "ask": "how long has my computer been running",
      "expect": [
        "uptime"
      ]
    },
    {
